{
  "private": true,
  "name": "vitepress-theme-teek-docs-template",
  "version": "1.0.0",
  "description": "vitepress-theme-teek 文档模板",
  "type": "module",
  "scripts": {
    "stats:gen": "npx tsx scripts/stats-gen.ts",
    "docs:dev": "npm run stats:gen && vitepress dev docs",
    "docs:build": "npm run stats:gen && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:pack": "npm run docs:build && node scripts/pack-dist.js"
  },
  "devDependencies": {
    "archiver": "^8.0.0",
    "echarts": "^5.6.0",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "markdown-it-mathjax3": "^4.3.2",
    "mermaid": "^11.15.0",
    "sass": "^1.89.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.3",
    "vitepress-plugin-llms": "^1.7.3",
    "vitepress-plugin-mermaid": "^2.0.17"
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "vitepress-theme-teek": "^1.5.7",
    "vue": "^3.5.16"
  }
}
